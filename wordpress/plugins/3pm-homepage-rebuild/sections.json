                    },
                    "elements": []
                  },
                  {
                    "id": "62ac28af",
                    "elType": "widget",
                    "widgetType": "text-editor",
                    "settings": {
                      "editor": "<p>Being independent shouldn’t mean figuring everything out alone. We bring music, creative services, and direct fan support into one evolving community—so artists can build on their own terms.</p>",
                      "text_color": "#a2aaa1",
                      "typography_typography": "custom",
                      "typography_font_family": "Exo",
                      "typography_font_size": {
                        "size": 16,
                        "unit": "px"
                      },
                      "_css_classes": "pm-copy"
                    },
                    "elements": []
                  },
                  {
                    "id": "14a2f94f",
                    "elType": "widget",
                    "widgetType": "text-editor",
                    "settings": {
                      "editor": "<p>Our own artists and releases are the testing ground. The ambition: prove a model of sovereign music, then share the blueprint with the world.</p>",
                      "text_color": "#a2aaa1",
                      "typography_typography": "custom",
                      "typography_font_family": "Exo",
                      "typography_font_size": {
                        "size": 16,
