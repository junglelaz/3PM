                  {
                    "id": "573548e4",
                    "elType": "widget",
                    "widgetType": "text-editor",
                    "settings": {
                      "editor": "<p>3rd Person Music is a musician-built Web3 ecosystem exploring a different future for independent music.</p>",
                      "text_color": "#a2aaa1",
                      "typography_typography": "custom",
